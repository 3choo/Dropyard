{
  "name": "gitctx",
  "private": true,
  "license": "MIT",
  "description": "Self-hosted release and Git panel for FiveM server content on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite",
    "build": "vite build",
    "setup": "node scripts/setup.mjs",
    "deploy": "npm run build && node scripts/wrangler.mjs deploy",
    "typecheck": "tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "migrate:remote": "node scripts/wrangler.mjs d1 migrations apply gitctx --remote"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "aws4fetch": "^1.0.20",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "undici": "^7.30.1",
    "zod": "^4.6.6"
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true,
    "sharp@0.33.5": true,
    "sharp@0.35.5": true
  }
}
