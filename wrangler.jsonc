{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gitctx",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],

  "dev": {
    // Local dev can't build containers on Windows; deploys are unaffected.
    "enable_containers": false
  },

  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/dl/*"]
  },

  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "gitctx" }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gitctx",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],

  // RAR extraction runs in a container (ZIP is stream-extracted in the Worker).
  // Building the image requires Docker; `wrangler deploy` handles the build.
  // standard-3 (2 vCPU / 8 GiB / 16 GB disk) so a big volume set fits next to
  // the batched extraction working directory. (wrangler 4.x has no
  // instance_type_custom yet — predefined types only.)
  "containers": [
    {
      "name": "gitctx-extract",
      "class_name": "ExtractRunner",
      "image": "./container/Dockerfile",
      "image_build_context": "./container",
      "max_instances": 5,
      "instance_type": "standard-3"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "EXTRACT_RUNNER", "class_name": "ExtractRunner" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ExtractRunner"] }],

  // Extraction is CPU-heavy for big zips (inflate + R2 writes).
  "limits": { "cpu_ms": 300000 },

  "vars": {
    "R2_S3_ACCOUNT_ID": "",
    "R2_BUCKET_NAME": "gitctx",
    "MAX_SINGLE_UPLOAD_MB": "90",
    "MAX_UNPACK_FILES": "200000",
    "MAX_UNPACK_FILE_MB": "20480",
    "MAX_UNPACK_TOTAL_MB": "51200"
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "issues": { "enabled": true },
    "traces": { "enabled": true }
  }
}
